CC=aztec34_cc
CFLAGS=-D__MSDOS__
STRIP=aztec34_sqz
LDFLAGS=-lm -lc
LD=aztec34_link
BINEXT=.com

TOOLS=h862bin$(BINEXT) cmdinfo$(BINEXT) cmdmod$(BINEXT) bin2cmd$(BINEXT) exe2cmd$(BINEXT) \
    bin2asm$(BINEXT)

all: $(TOOLS)

bin2asm.o b2aconf.o: b2aconf.h

h862bin$(BINEXT): h862bin.o
	$(LD) -o $@ $< $(LDFLAGS)

bin2asm$(BINEXT): bin2asm.o b2aconf.o
	$(LD) -o $@ $^ $(LDFLAGS)

include Makefile.emutest

bin2cmd$(BINEXT): bin2cmd.o
	$(LD) -o $@ $< $(LDFLAGS)

cmdinfo$(BINEXT): cmdinfo.o
	$(LD) -o $@ $< $(LDFLAGS)

cmdmod$(BINEXT): cmdmod.o
	$(LD) -o $@ $< $(LDFLAGS)

exe2cmd$(BINEXT): exe2cmd.o
	$(LD) -o $@ $< $(LDFLAGS)

.c.o:
	$(CC) $(CFLAGS) $<
	$(STRIP) $@

clean:
	$(RM) *.o $(TOOLS)
	$(RM) -r emu-test

test: test-emu2


.PHONY: all clean dist test
dist: dos-cmdtools.zip

dos-cmdtools.zip: $(TOOLS) Makefile.dos
	$(RM) $@
	zip -j $@ $(TOOLS)
